# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=AuditIQ API
APP_VERSION=1.0.0
DEBUG=false
API_BASE_URL=http://localhost:8000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (local + Netlify SPA)
# Prod SPA: https://auditiq-front.netlify.app/
CORS_ORIGINS=http://localhost:4200,https://auditiq-front.netlify.app

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Must be a JWT: "anon" "public" or "service_role" key from Project Settings → API.
# supabase-py does not accept newer "publishable" keys (sb_publishable_…).
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Postgres (for scripts/apply_supabase_schema.py — NOT the same as SUPABASE_KEY)
# Option A — paste the full URI from Dashboard → Settings → Database → Connection string:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
# Option B — database password only (script builds the URI from SUPABASE_URL):
# SUPABASE_DB_PASSWORD=your-database-password

# ── n8n Webhooks ──────────────────────────────────────────────────────────────
N8N_WEBHOOK_INOUT_URL=https://your-n8n-instance.com/webhook/auditiq-inout
N8N_WEBHOOK_TENDER_URL=https://your-n8n-instance.com/webhook/auditiq-tender

# Per-file upload workflow (Webhook node “Production URL” from workflow yhs1QhteOspEbuDN)
N8N_UPLOAD_WORKFLOW_ID=yhs1QhteOspEbuDN
N8N_WEBHOOK_DOCUMENT_UPLOAD_URL=

# Shared secret sent as X-N8n-Secret header in n8n → FastAPI callbacks
N8N_SECRET=change-me-in-production

# ── OCR Provider ─────────────────────────────────────────────────────────────
# Options: mock | google | aws
OCR_PROVIDER=mock
