# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=AuditIQ API
APP_VERSION=1.0.0
DEBUG=false
API_BASE_URL=http://localhost:8000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://rkiicgzkfwxwxcyhtdkp.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJraWljZ3prZnd4d3hjeWh0ZGtwIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NjIwNDU0OCwiZXhwIjoyMDkxNzgwNTQ4fQ.4d8hY8rE1qXcycpygyEwT9N-HKv0tOF97auCkkNRe9s
# ── n8n Webhooks (from n8n MCP get_workflow_details — workflow yhs1QhteOspEbuDN) ─
# Production: https://diny.app.n8n.cloud/webhook/auditiq-inout
N8N_WEBHOOK_INOUT_URL=https://diny.app.n8n.cloud/webhook/auditiq-inout
N8N_WEBHOOK_TENDER_URL=https://your-n8n-instance.com/webhook/auditiq-tender

# Shared secret — must match n8n env N8N_SECRET on HTTP nodes (X-N8n-Secret header)
N8N_SECRET=change-me-in-production

# Same INOUT webhook: file uploads trigger the same workflow with a synthetic session + safe callback
N8N_UPLOAD_WORKFLOW_ID=yhs1QhteOspEbuDN
N8N_WEBHOOK_DOCUMENT_UPLOAD_URL=https://diny.app.n8n.cloud/webhook/auditiq-inout

# ── OCR Provider ─────────────────────────────────────────────────────────────
# Options: mock | google | aws
OCR_PROVIDER=mock
